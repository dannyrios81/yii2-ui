{
    "name": "iguazoft/yii2-ui",
    "description": "39 Bootstrap 5 widgets to build admin dashboards in Yii2 from pure PHP: layout, sidebar, metric cards, charts, tables, forms, modals and more.",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "yii2-extension",
        "dashboard",
        "bootstrap5",
        "ui",
        "widgets",
        "admin",
        "backend",
        "atomic-design",
        "design-system",
        "components",
        "forms",
        "tables",
        "charts",
        "admin-panel",
        "admin-dashboard",
        "bootstrap",
        "chartjs",
        "yii2-widgets"
    ],
    "homepage": "https://github.com/dannyrios81/yii2-ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Iguazoft",
            "email": "info@iguazoft.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dannyrios81/yii2-ui/issues",
        "source": "https://github.com/dannyrios81/yii2-ui",
        "docs": "https://github.com/dannyrios81/yii2-ui/blob/main/README.md"
    },
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "~2.0.0",
        "yiisoft/yii2-bootstrap5": "~2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "iguazoft\\ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "iguazoft\\ui\\tests\\": "tests/"
        }
    },
    "extra": {
        "bootstrap": "iguazoft\\ui\\Bootstrap",
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --no-coverage"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
